# Copy to .env: make init

# Image versions
POSTGRES_VERSION=17
REDIS_VERSION=7-alpine
MINIO_VERSION=latest

# Published ports on the host (change if a port is already in use)
POSTGRES_PORT=5432
REDIS_PORT=6379
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
BACKEND_PORT=8080
FRONTEND_PORT=3000

# PostgreSQL credentials (also passed to the backend container)
POSTGRES_USER=files
POSTGRES_PASSWORD=files
POSTGRES_DB=files

# MinIO credentials (also passed to the backend container)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=user-files
