# Copy to backend/.env for running the backend locally: make backend-run
# Credentials must match the infrastructure started by make up-infra (root .env)

SERVER_PORT=8080

DB_URL=jdbc:postgresql://localhost:5432/files
DB_USERNAME=files
DB_PASSWORD=files

REDIS_HOST=localhost
REDIS_PORT=6379

MINIO_URL=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=user-files

MAX_FILE_SIZE=1024MB
MAX_REQUEST_SIZE=1024MB
